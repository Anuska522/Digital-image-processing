# AGGC-SSDA Configuration Template
# Copy to .env or set environment variables before running in production

# Maximum upload payload size in Megabytes (default: 50)
AGGC_MAX_UPLOAD_MB=50

# Maximum raster dimension (width or height) in pixels (default: 8192)
AGGC_MAX_DIM_PIXELS=8192

# Headless production mode for Streamlit (true / false)
STREAMLIT_SERVER_HEADLESS=true

# Streamlit port (default: 8501)
STREAMLIT_SERVER_PORT=8501

# Streamlit address binding (0.0.0.0 for containerized deployment, 127.0.0.1 for local)
STREAMLIT_SERVER_ADDRESS=0.0.0.0
