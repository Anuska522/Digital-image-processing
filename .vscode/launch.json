{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch AGGC-SSDA Dashboard",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "${workspaceFolder}/app.py"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Run All Tests (pytest)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "-v"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Run Benchmark CLI (aggc_ssda)",
            "type": "debugpy",
            "request": "launch",
            "module": "aggc_ssda",
            "args": [
                "--benchmark"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}

